# Default to normalized LF line endings for text files.
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf

# Unity YAML and project source.
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.mask text eol=lf
*.playable text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.inputactions text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.vfx text eol=lf
*.uxml text eol=lf
*.uss text eol=lf

# Code, configuration, and documentation.
*.cs text eol=lf
*.shader text eol=lf
*.compute text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary assets must never be line-ending normalized or text-merged.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tga binary
*.tif binary
*.tiff binary
*.psd binary
*.exr binary
*.hdr binary
*.fbx binary
*.blend binary
*.obj binary
*.wav binary
*.mp3 binary
*.ogg binary
*.aif binary
*.aiff binary
*.mp4 binary
*.mov binary
*.avi binary
*.ttf binary
*.otf binary
*.dll binary
*.pdb binary
*.unitypackage binary
